# Copy to relay/.env for local development. relay/.env is gitignored; never commit a key.
TYPESAFE_API_KEY=
# jev or stub. Defaults to jev when the key is set, otherwise stub.
PROVIDER=
# Comma-separated origins allowed to call this relay, e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
# Leave empty during local development to allow any origin.
ALLOWED_ORIGINS=
# Global daily cap for this deployment (default 20000).
PER_DAY=
PORT=8787
